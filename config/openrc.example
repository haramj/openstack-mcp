# Copy this file to ~/.config/openstack-mcp/openrc on the OpenStack controller.
# Fill in values for your cloud before running scripts/run-mcp-server.sh.

export OS_ENDPOINT_TYPE="internalURL"
export OS_REGION_NAME="RegionOne"
export OS_INTERFACE="internal"
export OS_AUTH_PLUGIN="password"
export OS_AUTH_URL="http://127.0.0.1:5000"
export OS_PROJECT_DOMAIN_NAME="Default"
export OS_TENANT_NAME="admin"
export OS_USERNAME="admin"
export OS_USER_DOMAIN_NAME="Default"
export OS_PROJECT_NAME="admin"
export OS_PASSWORD="change-me"
export OS_IDENTITY_API_VERSION="3"
